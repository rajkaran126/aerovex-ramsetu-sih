APP_NAME=AERO-TWIN
DEBUG=false
DATABASE_URL=sqlite:///./aero_twin.db
SIMULATION_FREQUENCY_HZ=1.0
MODELS_DIR=models_saved
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DATA_DIR=../data

# Groq Intelligence Configuration
# Leave blank during initial setup. Supply key when available.
GROQ_API_KEY=
ENGINE_AGENT_MODEL=llama-3.3-70b-versatile
SECURITY_AGENT_MODEL=llama-3.3-70b-versatile
MISSION_AGENT_MODEL=llama-3.3-70b-versatile
MAINTENANCE_AGENT_MODEL=llama-3.3-70b-versatile
ORCHESTRATOR_MODEL=llama-3.3-70b-versatile
